  "narrative": {
    "northStar": "The Room Being Refinished",
    "overview": "The page is the inside of a New Jersey home. Dark sections are a slate-navy painted wall; each wall section stands on a crisp white baseboard and a strip of oak plank floor. Light sections are the same room in daylight, a pale slate. Gold trim comes from the company's own flyer roof mark. The trade is the interaction: the floor starts worn and grey, and sanding (by finger or by an autoplay sander) takes it back to bare pale oak, which warms into finished amber.\n\nDensity is phone-first and plain-spoken: one column, big touch targets (44px minimum, 58px primary buttons), heavy uppercase headings in the system face, sentence-case body. No photography until the owner sends real work photos; the floor canvas is the only imagery.",
    "keyCharacteristics": [
      "Wall / baseboard / floor stack at the base of every dark section.",
      "Slate-navy ground, never black; gold as trim and the one fill CTA.",
      "Blue appears only on form controls (hover/focus), so it never competes with gold.",
      "System font stack, 900-weight uppercase display, tabular phone numbers.",
      "Flat UI; the only depth is physical (baseboard shadow, floor lighting)."
    ],
    "rules": [
      {
        "name": "The Never-Black Rule",
        "body": "The darkest ground is `wall-deep`. The brand's \"black and gold\" is translated to slate-navy and gold; pure or near-black grounds are out.",
        "section": "colors"
      },
      {
        "name": "The Two Accents, Two Jobs Rule",
        "body": "Gold is trim and the action fill. Blue is form-control outline only. Never put blue on a CTA fill or gold on a form-field outline.",
        "section": "colors"
      },
      {
        "name": "The Shout-Then-Talk Rule",
        "body": "Uppercase is for h1/h2 and the wordmark only. Everything else is sentence case.",
        "section": "typography"
      },
      {
        "name": "The Tabular Phone Rule",
        "body": "Phone numbers in the header use `font-variant-numeric: tabular-nums`.",
        "section": "typography"
      },
      {
        "name": "The Only-The-Room-Has-Depth Rule",
        "body": "Shadows belong to the baseboard and floor. Interface elements stay flat; state is shown by color and outline.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do end every wall section with a baseboard and a floor strip.",
      "Do keep gold for trim and the single fill action per screen; use blue only for form-control outlines.",
      "Do keep the system font stack with 900-weight uppercase h1/h2 and sentence-case everything else.",
      "Do keep touch targets at 44px or more and primary buttons at 58px.",
      "Do keep the hero floor `touch-action: none` and strips `pan-y`.",
      "Do route new contact actions to `sms:` / `tel:` (973) 493-2410, with a prefilled SMS body where it helps.",
      "Do use only facts in PRODUCT.md; put gaps in HANDOFF.md, never on the page."
    ],
    "donts": [
      "Don't use black or near-black grounds; the darkest ground is the deep wall.",
      "Don't add a sticky header, sticky call bar or floating button.",
      "Don't show the phone number more than once per screen (header, sent panel and footer are each on their own screen).",
      "Don't add an email address; none exists. If one is ever confirmed, it goes in the footer only.",
      "Don't invent towns, hours, prices, reviews, years, credentials or owner names.",
      "Don't use photos until the owner supplies real work photos; the flyer image is not proof of work.",
      "Don't highlight a whole service row on hover; only its arrow changes.",
      "Don't add shadows to cards, buttons or fields; depth belongs to the room."
    ]
  }
}